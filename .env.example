DATABASE_URL=postgresql+psycopg2://proof:change_me@db:5432/proof
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-long-random-string
EVIDENCE_DIR=/data/evidence
MAX_UPLOAD_MB=100
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false


# Forgot-password codes are sent by e-mail. For Gmail: turn on 2-Step Verification, create an
# "App password", then fill these three lines. Leave them empty to see the code in the server log instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# LOCAL TESTING ONLY: forgot-password skips the e-mail code on this computer. Remove it when you host the site.
DEMO_SHOW_CODE=true
