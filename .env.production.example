# Copy this file to ".env" ON THE SERVER and fill every line. Never upload the real .env to GitHub.
DOMAIN=yourdomain.com
# letters and numbers only (it is used inside a database address)
DB_PASSWORD=ReplaceWithLongLettersAndNumbers
# long random text, for example the output of: openssl rand -hex 32
JWT_SECRET=replace-with-64-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ReplaceWithAStrongAdminPassword
EVIDENCE_DIR=/data/evidence
MAX_UPLOAD_MB=100
# Gmail: turn on 2-Step Verification, create an App password, then fill these
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
